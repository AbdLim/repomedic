FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH


COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /usr/local/bin/
WORKDIR /workspace
COPY . /workspace

# --frozen respects uv.lock; --no-install-project keeps the target
# project uninstalled so source can be mounted separately for tests.
# Install pytest into the same environment even if a repo does not
# list it in its dev dependencies.
RUN uv sync --frozen --no-install-project \
    && uv pip install --python /opt/venv/bin/python "pytest>=8.3,<10"
